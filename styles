
/* General Body Styling */
body {
  font-family: Arial, sans-serif;
  background-color: #f4f4f9;
  margin: 0;
  padding: 20px;
  color: #333;
}

/* Header Styling */
h1 {
  font-size: 2em;
  text-align: center;
  margin-bottom: 10px;
}

/* Form and Input Styling */
form {
  max-width: 600px;
  margin: 20px auto;
  padding: 20px;
  background: #fff;
  border: 1px solid #ccc;
  border-radius: 8px;
}

input[type="date"], input[type="text"] {
  margin: 10px 0;
  padding: 10px;
  width: 100%;
  border-radius: 5px;
}

button {
  padding: 10px 20px;
  background-color: #007bff;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

button:hover {
  background-color: #0056b3;
}

/* Feeding List Styling */
#feedingList {
  list-style-type: none;
  padding: 0;
  margin: 20px auto;
  width: 80%;
  max-width: 600px;
}

.list-item {
  padding: 10px;
  margin: 10px 0;
  background: #ffffff;
  border: 1px solid #ccc;
  border-radius: 5px;
  text-align: center;
  transition: all 0.2s ease-in-out;
}

.list-item:hover {
  background-color: #f0f8ff;
  transform: scale(1.02);
}

.error-message {
  color: red;
  display: none;
  text-align: center;
}

/* Footer Styling */
footer {
  text-align: center;
  margin-top: 40px;
}
