
body {
  font-family: Arial, sans-serif;
  background-color: #f8f8f8;
  margin: 0;
  padding: 0;
}

h1 {
  text-align: center;
  margin-top: 20px;
}

.center-image {
  display: block;
  margin: 20px auto;
  width: 80%;
  max-width: 500px;
}

ul#feedingList {
  list-style-type: none;
  padding: 0;
  margin: 20px auto;
  width: 80%;
  max-width: 600px;
}

.list-item {
  background-color: #e0f7fa;
  padding: 10px;
  margin: 10px 0;
  border-radius: 5px;
  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
}

form {
  text-align: center;
  margin-top: 20px;
}

form input {
  margin: 10px;
  padding: 8px;
  width: 200px;
}

form button {
  padding: 10px 20px;
  background-color: #00796b;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

form button:hover {
  background-color: #004d40;
}

footer {
  text-align: center;
  margin-top: 40px;
  padding: 20px;
  background-color: #00796b;
  color: white;
}

footer a {
  color: white;
  text-decoration: none;
}


